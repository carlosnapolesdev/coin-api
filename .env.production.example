# Plantilla del `.env` del VPS. Copiar como `.env` junto al docker-compose.yml
# (ese nombre está gitignoreado) y rellenar los valores.
#
# ESTE FICHERO NO ES `.env.example`. Compose NO le pasa este `.env` a la app:
# solo lo usa para resolver los `${...}` del docker-compose.yml. Las claves que
# el compose fija por su cuenta —NODE_ENV, DATABASE_URL, PORT, UPLOAD_DIR— se
# ignoran si se ponen aquí, y a cambio hacen falta claves que `.env.example` no
# tiene (POSTGRES_PASSWORD). Copiar encima el `.env` de desarrollo no funciona.
#
# Una variable nueva requiere DOS sitios: aquí Y en el bloque `environment:` del
# docker-compose.yml. Solo aquí no llega a la app.
# Sin comentarios al final de una línea: aquí parsea Compose, no dotenv.

# ── Base de datos ──────────────────────────────────────────────────────────────
# Interpola en la DATABASE_URL que construye el compose contra el contenedor
# `postgres`. Vive también en el `.env` del host stack, pero Compose solo lee el
# `.env` de su propio directorio: hay que duplicarla aquí.
POSTGRES_PASSWORD=

# ── JWT ────────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres: `openssl rand -base64 48`. Si se pierde, se genera otro:
# solo invalida las sesiones abiertas.
JWT_SECRET=

# Opcionales — el compose ya aplica estos mismos valores por defecto.
JWT_EXPIRATION_MS=3600000
JWT_REMEMBER_ME_EXPIRATION_MS=604800000
JWT_ISSUER=crecik

# ── Obligatorias: `compose up` aborta si falta cualquiera ──────────────────────
# Origen del FRONTEND, no de la API.
CORS_ORIGIN=https://crecik.com

# Base de los enlaces de reset de contraseña. Apunta al frontend.
APP_URL=https://crecik.com

# El `...apps.googleusercontent.com` de Google Auth Platform. El client secret
# que Google genera junto a él no se usa.
GOOGLE_CLIENT_ID=

# El dominio debe estar verificado en Resend. Fallan cerrado a propósito: sin
# ellas los envíos se saltan con un aviso, que es como el reset de contraseña
# estuvo roto en silencio.
MAIL_FROM="Crecik <no-reply@crecik.com>"
RESEND_API_KEY=

# ── Opcionales ─────────────────────────────────────────────────────────────────
# Destinatario del digest diario de errores de cliente. Sin ella no sale digest
# y se avisa por log.
CLIENT_ERRORS_DIGEST_TO=

# Token de aaapis.com, usado solo por el seeder del catálogo de monedas.
AAAPIS_TOKEN=
